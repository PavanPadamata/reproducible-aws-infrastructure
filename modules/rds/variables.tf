# There is deliberately no password variable. RDS generates the master
# password and keeps it in Secrets Manager (see main.tf), so a plaintext
# password never appears in code, in variables or in a tfvars file.

variable "name" {
  description = "Identifier of the database instance, also used to name its subnet group and security group, for example \"myproj-dev-db\"."
  type        = string

  validation {
    condition     = can(regex("^[a-z][a-z0-9-]{0,40}$", var.name)) && !endswith(var.name, "-")
    error_message = "name must be 1-41 characters: lowercase letters, digits and hyphens, starting with a letter and not ending with a hyphen."
  }
}

variable "vpc_id" {
  description = "ID of the VPC the security group is created in."
  type        = string
}

variable "subnet_ids" {
  description = "Subnets for the database subnet group. Use the isolated data subnets. RDS requires at least two, in different Availability Zones, even for a single-AZ instance."
  type        = list(string)

  validation {
    condition     = length(var.subnet_ids) >= 2
    error_message = "subnet_ids needs at least two subnets in different Availability Zones: RDS rejects a subnet group with fewer."
  }
}

variable "allowed_security_group_ids" {
  description = "Security groups allowed to connect to the database port, typically the application's. Nothing else can reach the database."
  type        = list(string)
  default     = []
}

variable "engine" {
  description = "Database engine: postgres or mysql."
  type        = string
  default     = "postgres"

  validation {
    condition     = contains(["postgres", "mysql"], var.engine)
    error_message = "engine must be postgres or mysql."
  }
}

variable "engine_version" {
  description = "Engine version. Null uses the module's tested default for the engine (17 for postgres, 8.4 for mysql). A major version alone lets AWS apply minor upgrades."
  type        = string
  default     = null
}

variable "instance_class" {
  description = "Instance class. Billed per hour while the instance exists."
  type        = string
  default     = "db.t4g.micro"

  validation {
    condition     = startswith(var.instance_class, "db.")
    error_message = "instance_class must start with \"db.\", for example db.t4g.micro."
  }
}

variable "allocated_storage_gb" {
  description = "Initial storage in GiB. Billed while the instance exists."
  type        = number
  default     = 20

  validation {
    condition     = var.allocated_storage_gb >= 20
    error_message = "allocated_storage_gb must be at least 20, the minimum for gp3 storage."
  }
}

variable "max_allocated_storage_gb" {
  description = "Upper limit for storage autoscaling in GiB. Null turns autoscaling off."
  type        = number
  default     = null
}

variable "db_name" {
  description = "Name of an initial database to create. Null creates none."
  type        = string
  default     = null
}

variable "master_username" {
  description = "Name of the master user. The password is generated by RDS and stored in Secrets Manager."
  type        = string
  default     = "dbadmin"

  validation {
    condition     = can(regex("^[a-zA-Z][a-zA-Z0-9_]{0,15}$", var.master_username)) && !contains(["admin", "root"], lower(var.master_username))
    error_message = "master_username must be 1-16 characters, start with a letter, contain only letters, digits and underscores, and not be a reserved word such as admin or root."
  }
}

variable "kms_key_id" {
  description = "KMS key to encrypt storage with. Null uses the AWS-managed RDS key. The database is always encrypted."
  type        = string
  default     = null
}

variable "multi_az" {
  description = "Run a standby in a second Availability Zone with automatic failover. Doubles the instance cost."
  type        = bool
  default     = false
}

variable "backup_retention_days" {
  description = "Days to keep automated backups. Backups are what makes point-in-time recovery possible."
  type        = number
  default     = 7

  validation {
    condition     = var.backup_retention_days >= 1 && var.backup_retention_days <= 35
    error_message = "backup_retention_days must be between 1 and 35."
  }
}

variable "deletion_protection" {
  description = "Refuse to delete the instance. On by default; a throwaway environment must turn it off explicitly before it can be destroyed."
  type        = bool
  default     = true
}

variable "skip_final_snapshot" {
  description = "Skip the snapshot taken when the instance is deleted. Leave false for any database holding data you would miss."
  type        = bool
  default     = false
}

variable "cloudwatch_log_exports" {
  description = "Log types to publish to CloudWatch Logs, for example [\"postgresql\"]. Ingestion and storage are billed, so none by default."
  type        = list(string)
  default     = []
}

variable "auto_minor_version_upgrade" {
  description = "Let AWS apply minor engine upgrades during the maintenance window."
  type        = bool
  default     = true
}

variable "apply_immediately" {
  description = "Apply changes now instead of in the next maintenance window. Some changes cause a restart."
  type        = bool
  default     = false
}
